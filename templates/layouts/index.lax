@layout(default)

<main class="container">
    <section>
        <div class="col-md-12 p-3 p-md-5 text-center">
            <img class="img-fluid" 
                alt="@metadata.title" 
                width="30%" 
                height="30%"
                src="@metadata.home.image" />
            <h1><a href="@metadata.url" class="fw-bold">@metadata.home.title</a></h1>
            <h2 class="lead">@metadata.home.description</h2>
        </div>
        
        <h2 class="col-md-12 text-center p-3 p-md-5">Latest Posts</h2>
            
        <div class="row">
            @for posts
                <article class="col-md-4 p-3">
                <div class="p-3 shadow-sm rounded-5 bg-light">
                    <a href="@url" title="@title">
                        <img class="img-fluid rounded-5"
                            alt="@title" 
                            width="100%" 
                            height="100%"
                            src="@image" />
                    </a>   
                    <div class="p-2">
                        <h2>
                            <a href="@url">@title</a>
                        </h2>                        
                        <time datetime="@date">@date</time>
                        @if author
                            <span class="post-author">by @author</span>
                        @end
                        <p class="post-excerpt">@excerpt</p>
                    </div>
                    </div>
                </article>
            @end
            <div class="col-md-12 p-3 p-md-5 text-center">
                <a href="/posts/" class="btn btn-primary">View All Posts →</a>
            </div>
        </div>                   
    </section>
</main>