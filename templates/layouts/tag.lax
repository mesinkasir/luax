@layout("default.lax")

<main class="container">
    <section class="row">
        <div class="col-md-12 p-3 p-md-5 text-center mt-3">
            <h1 class="display-4">#@tag</h1>
            <h2 class="lead">@count posts with this tag</h2>
        </div>

        <div class="col-md-8 mx-auto">
            @for posts
            <div class="card mb-3">
                <div class="card-body">
                    <h5><a href="@url">@title</a></h5>
                    <p>@excerpt</p>
                    <small>@date</small>
                </div>
            </div>
            @end
        </div>

        <div class="col-md-12 text-center mt-4">
            <a href="/tags/" class="btn btn-primary rounded-5">← All Tags</a>
        </div>
    </section>
</main>