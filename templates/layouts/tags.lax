@layout("default.lax")

<main class="container">
    <section class="row">
        <div class="col-md-12 p-3 p-md-5 text-center mt-3">
            <h1 class="display-4">🏷 Tags</h1>
            <h2 class="lead">All tags on this site</h2>
        </div>

        <div class="col-md-8 mx-auto p-3">
            <div class="d-flex flex-wrap gap-2 justify-content-center">
                @for tags
                <a href="@url" class="btn btn-outline-primary rounded-5 px-4 py-2">
                    #@name (@count)
                </a>
                @end
            </div>
        </div>
    </section>
</main>